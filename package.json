  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@vitest/coverage-istanbul": "^4.0.4",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4"
  },
  "packageManager": "yarn@4.10.3",
  "fabrique": {
    "version": "1.0.12",
    "type": "lib"
  },
  "dependencies": {
    "@thingmate/entity": "^0.9.0",
